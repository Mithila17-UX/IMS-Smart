# Firebase Web App config (get from Firebase Console → Project Settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect to the local Firebase Emulator Suite
# Leave empty or "false" in staging/production
VITE_USE_EMULATORS=true

# Emulator ports (only needed if you change the defaults in firebase.json)
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_STORAGE_PORT=9199
VITE_EMULATOR_FUNCTIONS_PORT=5001

# App metadata
VITE_APP_NAME=IMS
VITE_APP_COMPANY=Avalon Digital
VITE_APP_VERSION=1.0.0
