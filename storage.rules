rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────
    // Helper functions (mirror Firestore rule helpers)
    // ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == "superadmin";
    }

    function isClientAdmin(clientId) {
      return isSignedIn() &&
             request.auth.token.clientId == clientId &&
             request.auth.token.role == "client_admin";
    }

    function isClientMember(clientId) {
      return isSignedIn() && request.auth.token.clientId == clientId;
    }

    // Maximum file upload size: 10 MB
    function isValidSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // ─────────────────────────────────────────────────────────────
    // Client-scoped files: clients/{clientId}/...
    // ─────────────────────────────────────────────────────────────

    // Bank statement attachments (private — only client admin can upload/read)
    match /clients/{clientId}/bankStatements/{filename} {
      allow read: if isSuperAdmin() || isClientAdmin(clientId);
      allow create: if isClientAdmin(clientId) && isValidSize() &&
                       request.resource.contentType.matches("application/(pdf|octet-stream)|image/(jpeg|png|webp)");
      allow update, delete: if false;
    }

    // Client logo
    match /clients/{clientId}/logo/{filename} {
      allow read: if isSignedIn();
      allow create, update: if isSuperAdmin() && isValidSize() &&
                               request.resource.contentType.matches("image/(jpeg|png|webp|svg\\+xml)");
      allow delete: if isSuperAdmin();
    }

    // Data exports (generated by Cloud Functions, readable by admin)
    match /clients/{clientId}/exports/{filename} {
      allow read: if isSuperAdmin() || isClientAdmin(clientId);
      allow write: if false; // Written by Cloud Functions only
    }

    // Backups (generated by Cloud Functions, readable by super admin only)
    match /backups/{filename} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
