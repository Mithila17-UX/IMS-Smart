# nginx config for self-hosted deployment of IMS
# Copy to /etc/nginx/sites-available/ims and symlink to /etc/nginx/sites-enabled/
# Replace: your-domain.com, /path/to/ims/dist, /path/to/ssl

server {
    listen 80;
    server_name ims.avalondigital.lk;
    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ims.avalondigital.lk;

    # SSL (use certbot / Let's Encrypt or your own certificate)
    ssl_certificate     /etc/letsencrypt/live/ims.avalondigital.lk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ims.avalondigital.lk/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Document root — copy the output of `pnpm build` here
    root /var/www/ims/dist;
    index index.html;

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # SPA fallback — every path returns index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Immutable asset caching (Vite hashes filenames)
    location /assets/ {
        expires max;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # No caching for index.html so updates deploy immediately
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
}
